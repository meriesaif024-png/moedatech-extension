{
  "manifest_version": 3,
  "name": "Moedatech Detector",
  "version": "2.0.0",
  "description": "Leave feedback notes pinned to specific elements on the team's web apps, shared with the whole team.",
  "permissions": ["tabs", "storage", "activeTab", "notifications", "alarms", "scripting"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://ai.moedatech.net/*",
    "https://web-beta.moedatech.net/*",
    "https://os.moedatech.net/*",
    "https://feedback-api-production-8bc5.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ai.moedatech.net/*", "https://web-beta.moedatech.net/*", "https://os.moedatech.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moedatech Detector",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "open_dashboard": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open the notes dashboard"
    }
  }
}
